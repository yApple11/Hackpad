{
    "manufacturer": "yaseen baladi",
    "keyboard_name": "hackpad",
    "maintainer": "yApple11",
    "bootloader": "rp2040",
    "diode_direction": "COL2ROW",
    "features": {
        "encoder":true,
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true
    },
    "matrix_pins": {
        "direct": [
            ["GP10"] //the rotary encoder button
            ["GP1", "GP3", "GP6"],
            ["GP2", "GP5", "GP7"]
        ]
    },
    "processor": "RP2040",
    "url": "",
    "usb": {
        "device_version": "1.0.0",
        "pid": "0x0000",
        "vid": "0xFEED"
    },
    "layouts": {
        "LAYOUT_ortho_2x3": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0},
                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 1, "y": 1},
                {"matrix": [1, 2], "x": 2, "y": 1}
            ]
        }
    }
    "encoder":{
        "rotary": [
            {"pin_a": "GP9", "pin_b": "GP8", "resolution": 4}
        ]
    }
}